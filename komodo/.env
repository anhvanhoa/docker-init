####################################
# 🦎 KOMODO COMPOSE - VARIABLES 🦎 #
####################################

## Phiên bản image (semver major.minor.patch)
COMPOSE_KOMODO_IMAGE_TAG="2"
## Nơi lưu backup database trên host
COMPOSE_KOMODO_BACKUPS_PATH=./backups

## Thông tin đăng nhập MongoDB — NÊN đổi trước khi chạy
KOMODO_DATABASE_USERNAME=admin
KOMODO_DATABASE_PASSWORD=IWEgPY2g9F1rbDuKr8t8Xc0lcBFRK785

## Múi giờ
TZ=Asia/Ho_Chi_Minh

#=-------------------------=#
#= Komodo Core Environment =#
#=-------------------------=#

## URL truy cập Komodo (dùng cho OAuth/Webhook). Đổi thành domain/IP thực tế của bạn.
KOMODO_HOST=http://localhost:9120
## Tiêu đề hiển thị trên tab trình duyệt
KOMODO_TITLE=Komodo

## Cho phép Periphery kết nối bằng public key được sinh tự động
KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub

## Bật đăng nhập bằng username + password
KOMODO_LOCAL_AUTH=true
## Tài khoản admin khởi tạo lần đầu — NÊN đổi mật khẩu ngay sau khi đăng nhập
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=changeme

## Tên server đầu tiên (thường đặt theo hostname)
KOMODO_FIRST_SERVER_NAME=Local

KOMODO_DISABLE_CONFIRM_DIALOG=false
KOMODO_DISABLE_INIT_RESOURCES=false

## Secret dùng để xác thực webhook — đã sinh ngẫu nhiên sẵn
KOMODO_WEBHOOK_SECRET=BqtBFPY4IMnUackMvKK2KNCYuj+dLmiXR1RDnU7P9Jg=
## Secret dùng để tạo JWT — đã sinh ngẫu nhiên sẵn
KOMODO_JWT_SECRET=f2Qnjf1eH9OItijqZEfpg1ac2SCed1VRqkRLdfM/yWk=
KOMODO_JWT_TTL="1-day"

KOMODO_MONITORING_INTERVAL="15-sec"
KOMODO_RESOURCE_POLL_INTERVAL="1-hr"

KOMODO_DISABLE_USER_REGISTRATION=false
KOMODO_ENABLE_NEW_USERS=false
KOMODO_DISABLE_NON_ADMIN_CREATE=false
KOMODO_TRANSPARENT_MODE=false

## OIDC / Github / Google Oauth (tắt mặc định, bật nếu cần)
KOMODO_OIDC_ENABLED=false
KOMODO_GITHUB_OAUTH_ENABLED=false
KOMODO_GOOGLE_OAUTH_ENABLED=false

KOMODO_LOGGING_PRETTY=false
KOMODO_PRETTY_STARTUP_CONFIG=false

#=------------------------------=#
#= Komodo Periphery Environment =#
#=------------------------------=#

## Trỏ Periphery về Core (đây là container Core cùng compose file nên dùng tên service)
PERIPHERY_CORE_ADDRESS=ws://core:9120
PERIPHERY_CONNECT_AS=${KOMODO_FIRST_SERVER_NAME}
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub

## Thư mục gốc mà Periphery quản lý (chứa các stack / repo)
PERIPHERY_ROOT_DIRECTORY=/etc/komodo

PERIPHERY_DISABLE_TERMINALS=false
PERIPHERY_DISABLE_CONTAINER_TERMINALS=false

PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname

PERIPHERY_LOGGING_PRETTY=false
PERIPHERY_PRETTY_STARTUP_CONFIG=false